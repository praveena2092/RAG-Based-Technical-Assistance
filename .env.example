# ── LLM / embeddings (AIPipe or any OpenAI-compatible endpoint) ──────────
OPENAI_API_KEY=your-aipipe-or-openai-key
OPENAI_BASE_URL=https://aipipe.org/openai/v1
# EMBEDDING_MODEL=text-embedding-3-small
# CHAT_MODEL=gpt-4o-mini

# ── Qdrant Cloud ─────────────────────────────────────────────────────────
QDRANT_URL=https://your-cluster-id.region.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=tds_kb

# ── Discourse scraping only (copy from browser DevTools -> Cookies) ──────
DISCOURSE_SESSION_COOKIE=your-_forum_session-cookie
DISCOURSE_T_COOKIE=your-_t-cookie

# ── Optional tunables ────────────────────────────────────────────────────
# CHUNK_TOKEN_LIMIT=4096
# EMBED_BATCH_SIZE=32
# UPLOAD_BATCH_SIZE=10
# TOP_K=7
